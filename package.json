{
  "name": "knowledge-wiki",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "start:game": "npm run dev --workspace @lernhelden/app",
    "build": "npm run build:game && docusaurus build",
    "build:game": "npm run build --workspace @lernhelden/app",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc && npm run typecheck --workspace @lernhelden/engine && npm run typecheck --workspace @lernhelden/app",
    "test": "npm run test:legacy-hash && npm run test:assets && npm run test --workspace @lernhelden/engine && npm run test --workspace @lernhelden/app",
    "test:assets": "node scripts/verify-sprite-assets.mjs",
    "pretest:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "playwright test",
    "test:legacy-hash": "node scripts/verify-legacy-hash.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "@playwright/test": "^1.54.1",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
